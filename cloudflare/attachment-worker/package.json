{
  "name": "lions-portal-attachment-worker",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --check src/index.js && wrangler deploy --dry-run --config wrangler.ci.toml",
    "migrate:local": "wrangler d1 migrations apply PORTAL_DB --local",
    "migrate:remote": "wrangler d1 migrations apply lions-portal-dados --remote"
  },
  "devDependencies": {
    "wrangler": "^4.28.1"
  }
}
