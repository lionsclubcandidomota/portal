name = "lions-portal-anexos"
main = "src/index.js"
compatibility_date = "2026-08-04"

[[r2_buckets]]
binding = "ATTACHMENTS"
bucket_name = "SEU_BUCKET_R2"

[[d1_databases]]
binding = "PORTAL_DB"
database_name = "lions-portal-dados"
database_id = "00000000-0000-0000-0000-000000000000"
migrations_dir = "migrations"

[vars]
ALLOWED_ORIGINS = "https://lionsclubcandidomota.github.io,http://localhost:*,http://127.0.0.1:*"
# Usada somente na primeira importação da versão antiga. Pode ser removida após confirmar a migração.
PUBLIC_DATA_URL = "https://lionsclubcandidomota.github.io/portal/data/dados.json"
SESSION_TTL_SECONDS = "1800"
DOWNLOAD_TTL_SECONDS = "300"
