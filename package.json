{
  "name": "portal-lions-candido-mota",
  "version": "6.52.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "node tools/build-css.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "node tools/lint.mjs",
    "audit:modules": "node tools/module-graph-audit.mjs",
    "audit:css": "node tools/css-audit.mjs",
    "audit:a11y": "node tools/accessibility-audit.mjs",
    "audit:security": "node tools/security-audit.mjs",
    "audit:performance": "node tools/performance-audit.mjs",
    "audit:media": "node tools/media-audit.mjs",
    "audit:media:required": "node tools/media-audit.mjs --required",
    "audit:visual": "node tools/visual-audit.mjs",
    "audit:visual:required": "node tools/visual-audit.mjs --required",
    "version:sync": "node tools/sync-version.mjs",
    "version:check": "node tools/sync-version.mjs --check",
    "validate": "node tools/validate.mjs",
    "quality": "npm run version:check && npm run lint && npm test && npm run audit:modules && npm run audit:lazy && npm run audit:integrated && npm run audit:css && npm run audit:a11y && npm run audit:security && npm run audit:performance && npm run audit:media:required && npm run validate",
    "check": "npm run quality",
    "backup:local": "node tools/create-local-backup.mjs",
    "data:migrate": "node tools/migrate-official-data.mjs",
    "migrate:media": "node tools/extract-media.mjs",
    "release:manifest": "node tools/release-manifest.mjs",
    "release:audit": "node tools/release-audit.mjs",
    "release:verify": "node tools/release-manifest.mjs --check",
    "release:check": "npm run quality && npm run release:audit && npm run release:verify",
    "release:prepare": "node tools/prepare-release.mjs",
    "homologacao": "node tools/homologation-server.mjs --open",
    "homologacao:server": "node tools/homologation-server.mjs",
    "audit:integrated": "node tools/integrated-homologation.mjs",
    "audit:lazy": "node tools/lazy-loading-audit.mjs"
  }
}
